<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>false</InvariantGlobalization>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<NoWarn>CS1591;CS1572;CS1573</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="yswenli.png" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="yswenli.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\LuBan.EMailKit\LuBan.EMailKit.csproj" />
		<ProjectReference Include="..\LuBan.Web.Core\LuBan.Web.Core.csproj" />
		<ProjectReference Include="..\LuBan.Wechat\LuBan.Wechat.csproj" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\face-recognition.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\files\" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="System.Security.Cryptography.Xml" Version="10.0.10" />
	</ItemGroup>

</Project>
