<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>$(AssemblyName)</Title>
    <Version>2026.9.16.1</Version>
    <Authors>yswenli</Authors>
    <Description>LuBan.AIAgent 是基于 Microsoft Agent Framework 的 AI Agent 库，支持自然语言操作浏览器、文件系统、脚本、Web、检索、长期记忆、MCP、上下文压缩等。</Description>
    <Copyright>$(Authors)</Copyright>
    <PackageIcon>favicon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>$(AssemblyName);ai;agent;Microsoft.Agents;LuBan;yswenli</PackageTags>
    <!-- 不复制 Playwright 驱动（约 101MB）到输出目录，运行时由 PlaywrightDriverResolver 按需安装到用户目录 -->
    <PlaywrightPlatform>none</PlaywrightPlatform>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\favicon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LuBan.Common\LuBan.Common.csproj" />
    <ProjectReference Include="..\LuBan.DI\LuBan.DI.csproj" />
    <ProjectReference Include="..\LuBan.Threading\LuBan.Threading.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI.Foundry" Version="1.5.0" />
    <!-- 勿升到 10.10.0：Microsoft.Extensions.AI.OpenAI 10.10.0 强制依赖 OpenAI 2.13.0，
         而 2.13.0 的流式工具调用表示有破坏性变更（工具调用 chunk 解析为空 update、轮次静默结束），
         下游 LubanAgentCli 因此钉住 OpenAI [2.12.0, 2.13.0)。升级前必须先适配并实测流式工具调用。 -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
  </ItemGroup>

</Project>